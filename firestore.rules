rules_version = '2';
// 記録は saves/<ユーザーID> に1件だけ。本人しか読み書きできない
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && (request.resource == null || request.resource.data.state.size() < 500000);
    }
  }
}
